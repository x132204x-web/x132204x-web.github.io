# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# Static deployment output belongs in out/, never beside app/ sources.
/assets/
/index.html
/en/index.html
/zh/index.html
/more/index.html
/profile/index.html
/articles/*/index.html
/projects/*/index.html
/updates/**/index.html
/updates/index.html

# Bilingual resumes are generated for the Pages artifact.
/public/resume-xia-shiqi-zh.pdf
/public/resume-xia-shiqi-en.pdf
